# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# Supabase dashboard: Project Settings > API Keys (or the "Connect" button).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx   # safe for the browser
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx                          # server only, keeps full access
